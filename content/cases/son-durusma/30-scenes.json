            { "type": "SCORE", "category": "ARASTIRMA", "amount": 40 }
          ],
          "feedback": {
            "text": "Kare 22. Spiralli bir not bloğu; üst sayfa koparılmış, spiralde kâğıt kırpıntıları kalmış. Masada başka kâğıt yok. Kalemin kapağı açık.",
            "short": "Koparılmış sayfa"
          }
        },
        {
          "id": "ob_beyaz",
          "name": "Şeridin dışı",
