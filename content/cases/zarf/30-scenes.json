          "feedback": {
            "text": "Camlı panoda dahili liste. “201 — Müdürlük Makamı (Sekr.)”. “214 — Devir Servisi-2 (S. Kaplan, G. Erdem)”. “231 — Kontrol (H. Ekinci)”.",
            "short": "Rehber"
          }
        },
        {
          "id": "ob_kamera",
          "name": "Dom kamera",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 160, "y": 14, "w": 30, "h": 20 } }],
