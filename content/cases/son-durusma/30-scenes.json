          "feedback": {
            "text": "Kare 12. Köşede bir akvaryum; içinde iki çipura, oyuncak bir batık gemi. Balıklar bir şey görmüştür belki. İfade vermiyorlar.",
            "short": "Akvaryum"
          }
        }
