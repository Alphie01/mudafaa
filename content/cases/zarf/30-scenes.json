            { "type": "SCORE", "category": "ARASTIRMA", "amount": 40 }
          ],
          "feedback": {
            "text": "Kahverengi iç yazışma zarfları, lastiklerle bağlı desteler. Her destenin üstünde bir barkod aralığı: “0451–0500”. Zarflar servislere zimmetle veriliyormuş.",
            "short": "Zarflar"
          }
        },
        {
          "id": "ob_ocak",
          "name": "Çay ocağı",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 270, "y": 80, "w": 60, "h": 120 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": 20 }],
          "feedback": {
            "text": "Çay ocağının kapısı aralık; demlik buharı, bir radyo. İçeride yaşlı bir çaycı, bir deftere bir şey yazıyor. Seni görünce defteri kapatıyor.",
            "short": "Çay ocağı"
          }
        },
        {
          "id": "ob_yangin",
          "name": "Yangın dolabı",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 210, "y": 140, "w": 24, "h": 40 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "Kırmızı bir yangın dolabı; camında “Acil durumda kırınız.” Bu dosyada acil olan başka şeyler var.",
            "short": "Yangın dolabı"
          }
        },
        {
          "id": "ob_sebil",
          "name": "Su sebili",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 176, "y": 150, "w": 24, "h": 50 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "Bir su sebili, boş damacana, plastik bardaklar. Herkes buradan geçer; kimse bir şey bırakmaz.",
            "short": "Sebil"
          }
        }
      ]
    },
    {
