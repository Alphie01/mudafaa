# PostgreSQL: geliştirme (5432) ve test (5433) veritabanları
DATABASE_URL=postgresql://mudafaa:mudafaa@localhost:5432/mudafaa
DATABASE_URL_TEST=postgresql://mudafaa:mudafaa@localhost:5433/mudafaa_test

# Redis: geliştirme (6379) ve test (6380)
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6380

# Firebase Auth Emulator (yalnızca yerel geliştirme)
FIREBASE_PROJECT_ID=demo-mudafaa
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# API süreci: dinleme portu ve rol (api | worker)
PORT=3000
APP_ROLE=api
