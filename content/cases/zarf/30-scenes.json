          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 20, "y": 100, "w": 70, "h": 150 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "Merdivende bulanık iki takipçi; ellerinde dosyalar. Biri telefonla konuşuyor. Her sabah oradalar; bu sabah da oradaydılar.",
            "short": "Merdiven"
          }
        },
        {
          "id": "ob_pencere",
          "name": "Koridor penceresi",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 250, "y": 60, "w": 70, "h": 60 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "Pencerede yağmur, gren, bir ışık patlaması. Dışarıdaki bir şey değil; kameranın kendi gürültüsü.",
            "short": "Pencere"
          }
        }
      ]
    },
