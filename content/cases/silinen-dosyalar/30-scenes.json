          "feedback": {
            "text": "Eksperin unuttuğu bir karton bardak, kapağında ruj izi yok, bir golf kulübünün logosu var. Bursa’da üç golf sahası var; herkes birine gider.",
            "short": "Karton bardak"
          }
        }
