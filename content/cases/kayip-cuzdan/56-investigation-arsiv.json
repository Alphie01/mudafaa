    {
      "id": "INV_EMANET_SON",
      "type": "STORY",
      "chapter": "Bölüm 2 · Soruşturma",
      "eyebrow": "DAVA #01 · SORUŞTURMA",
      "title": "Emanet bürosu",
      "background": "adliye",
      "lines": [
        {
          "lines": [
            {
              "speaker": "narrator",
              "text": "Melek Hanım poşetleri tek tek numaralarına göre rafa dizdi. Sarı notun poşetini en son kaldırdı, bir an baktı."
            },
            {
              "speaker": "katip",
              "text": "Yedi aydır burada. Kimse sormadı. Polis de okumadı, ben de okumadım. Okumak bizim işimiz değil, saklamak bizim işimiz."
            },
            { "speaker": "katip", "text": "Siz okudunuz. Avukatlar bazen okur. Bazen." },
            {
              "speaker": "player",
              "text": "“Saklamak bizim işimiz.” Bir emanet bürosu ile bir kayıp eşya bürosu arasında fark var mı? İkisi de sahibini bekleyen şeyleri tutuyor.",
              "style": "thought"
            }
          ]
        }
      ],
      "choices": [
        {
          "id": "EMS_ORNEK",
          "kind": "OPTION",
          "label": "“Tutanağın onaylı örneğini istiyorum.”",
          "effects": [{ "type": "VAR", "var": "tutanak_ornek", "op": "set", "value": true }],
          "next": "$return",
          "responses": [
            {
              "lines": [
                {
                  "speaker": "katip",
                  "text": "Dilekçe verin, harcını yatırın, yarın alırsınız. Dosya inceleme hakkınız var, örnek hakkınız da var. Ama sırası var."
                }
              ]
            }
          ]
        },
        {
          "id": "EMS_GIT",
          "kind": "OPTION",
          "label": "Teşekkür edip çık",
          "next": "$return",
          "responses": [
            {
              "lines": [
                {
                  "speaker": "player",
                  "text": "Bodrumdan çıkarken merdivenlerde bir avukatın kâtibe bağırdığını duydum. Melek Hanım’a bir çikolata almayı not ettim.",
                  "style": "thought"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "INV_EMANET",
      "type": "DOCUMENT",
      "chapter": "Bölüm 2 · Soruşturma",
      "eyebrow": "DAVA #01 · SORUŞTURMA",
      "title": "El koyma tutanağı · emanet",
      "background": "adliye",
      "hud": ["exam_left"],
      "lines": [
        {
          "lines": [
            { "speaker": "narrator", "text": "10.00 — BURSA ADLİYESİ, EMANET BÜROSU", "bg": "adliye", "style": "card" },
            {
              "speaker": "narrator",
              "text": "Bodrum kat. Metal raflar, numaralı poşetler, nem. Masada bir kayıt defteri ve soğumuş bir simit."
            },
            {
              "speaker": "katip",
              "text": "Melek Şen, kâtip. Dosya numarası? Tamam. Dokunmak yok, bakmak serbest. Eldiven şurada. Yarım saat."
            },
            {
              "speaker": "narrator",
              "text": "Masaya dört poşet ve bir tutanak fotokopisi dizildi. Cüzdanın kendisi burada değildi; soruşturmada yediemin olarak sahibine verilmişti."
            },
            {
              "speaker": "katip",
              "text": "Cüzdanı savcılık müştekiye bıraktı, yediemin. Fotoğrafı varmış içinde, kadın ağlamış. Teslim tutanağı dosyada; içindekiler tek tek yazılı."
            },
            {
              "speaker": "player",
              "text": "Her poşet tutanaktaki bir satır. Bir hayatın yedi ay önceki sabahı, şeffaf naylonun içinde.",
              "style": "thought"
            },
            {
              "speaker": "narrator",
              "text": "Bir alet seç, sonra şüpheli satıra dokun. Doğru alet ve doğru satır yeni bir ipucu verir; boş deneme bir hak götürür."
            }
          ]
        }
      ],
      "header": { "left": "EMANET 2026/1184 · EL KOYMA TUTANAĞI", "right": "7 MART · 08.15" },
