    "estimatedMinutes": 105,
    "requiredRank": "KIDEMLI",
    "summary": "Mudanya limanında bir puantör iki konteynerin arasında ölü bulunur. Kavga ettiği laşing işçisi Tarık Demirel “öldürmek için geri döndü” iddiasıyla müebbetle yargılanıyor. Tarık bir yumruk attığını saklamıyor; ama yumruk öldürür mü? Elinde bir otopsi raporu, bir telefon tutanağı ve kırk dakikalık bir boşluk var.",
    "coverCharacter": "tarik",
    "legalReview": { "status": "APPROVED", "by": "Claude (iç inceleme)", "at": "2026-10-20" }
  },
  "config": {
    "startNode": "PR_00",
    "scoring": {
      "categories": [
        {
          "id": "HUKUKI_BILGI",
          "label": "Hukuki bilgi",
          "advice": {
            "weak": "Kasten öldürme, olası kast ve yaralama sonucu ölüm arasındaki farkı (TCK 81, 21/2, 87/4, 23) ve güncel aralıkları tekrar et.",
            "medium": "Vasıf ayrımlarını biliyorsun; ağır neticede illiyet ve taksir şartını (TCK 23) savunmaya bağla.",
            "strong": "Vasıf, olası kast ve neticesi sebebiyle ağırlaşmış suç ayrımında isabetlisin."
          }
        },
        {
          "id": "DELIL_ANALIZI",
          "label": "Delil analizi",
          "advice": {
            "weak": "Otopsi raporunu satır satır oku: kırığın şekli, karşı darbe, mide içeriği. İpuçlarını tahtada birleştir.",
            "medium": "Delilleri buldun; bazılarını birbirine bağlamadın.",
            "strong": "Otopsiyi, kayıtları ve fotoğrafları birbirine bağlayıp ölümün saatini ve şeklini kurdun."
          }
        },
        {
          "id": "ARASTIRMA",
          "label": "Araştırma",
          "advice": {
            "weak": "Fotoğraflara, büfeye, eve, kâğıtlara git. Kimsenin bakmadığı yerde dosyanın yarısı duruyor.",
            "medium": "Çoğu yeri gördün; birkaç kapıyı çalmadın.",
            "strong": "Araştırman eksiksizdi."
          }
        },
        {
          "id": "SORGULAMA",
          "label": "Sorgulama",
          "advice": {
            "weak": "Önce bastır, sonra sun. Dürüst tanığı yalancı çıkarma; yanıldığını kâğıtla göster.",
            "medium": "Çapraz sorgun etkiliydi; bazı çelişkiler açık kaldı.",
            "strong": "Çapraz sorgun tanıkları kendi ağızlarıyla düzeltti."
          }
        },
        {
          "id": "SAVUNMA_STRATEJISI",
          "label": "Savunma stratejisi",
          "advice": {
            "weak": "Yumruğu ve ölümü ayır; esas savunmayı ispatladığın şeye dayandır.",
            "medium": "Stratejin tutarlıydı; esas savunma delillerinin bir kısmına yaslandı.",
            "strong": "Bir yumruğu kabul edip bir ölümü reddeden savunmayı kurdun."
          }
        },
        {
          "id": "USUL_BILGISI",
          "label": "Usul bilgisi",
          "advice": {
            "weak": "Delil dilekçesi (CMK 177), ara karar talepleri, suç duyurusu (CMK 158), ek savunma (CMK 226): her biri doğru zamanda.",
            "medium": "Usul hamlelerin çoğu yerindeydi.",
            "strong": "Usul hamlelerin yerinde ve zamanındaydı."
          }
        }
      ],
