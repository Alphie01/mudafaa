{
  "name": "@mudafaa/api",
  "version": "0.0.0",
  "private": true,
  "description": "Müdafaa NestJS API",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:test": "node scripts/migrate-test.mjs",
    "seed": "nest build && node dist/cli/seed.js"
  },
  "dependencies": {
    "@mudafaa/case-schema": "*",
    "@mudafaa/engine": "*",
    "@mudafaa/validator": "*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
