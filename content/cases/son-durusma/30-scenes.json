          "effects": [{ "type": "DISCOVER", "evidence": "clue_raki" }],
          "feedback": {
            "text": "Kare 9. Masada dolu bir rakı kadehi, buzu erimiş. Otopsi: maktulün kanında alkol yok. Üç yıldır içmiyormuş; kadehi kim, kimin için koydu?",
            "short": "Dolu kadeh"
          }
        },
