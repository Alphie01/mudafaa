            { "type": "SCORE", "category": "ARASTIRMA", "amount": 40 }
          ],
          "feedback": {
            "text": "Tavanda bir dom kamera; merdivene dönük, kontrol odasının kapısı kadrajın kenarında. Etiket: “Kayıt süresi 90 gün.” Saat işliyor.",
            "short": "Kamera"
          }
        },
        {
          "id": "ob_dolap",
          "name": "Evrak dolabı",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 100, "y": 100, "w": 50, "h": 100 } }],
