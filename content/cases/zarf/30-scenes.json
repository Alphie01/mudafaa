            { "type": "SCORE", "category": "ARASTIRMA", "amount": 40 }
          ],
          "feedback": {
            "text": "Raf tozlu; bir tek dikdörtgen temiz. Defter boyutunda. Bir şey burada yıllarca durmuş, sonra kaldırılmış.",
            "short": "Toz izi"
          }
        },
        {
          "id": "ob_cekmece",
          "name": "Üçüncü çekmece",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 150, "y": 168, "w": 50, "h": 22 } }],
          "effects": [
            { "type": "DISCOVER", "evidence": "clue_kilit" },
            { "type": "SCORE", "category": "ARASTIRMA", "amount": 40 }
          ],
          "feedback": {
            "text": "Üçüncü çekmece. Kilidinin dili pastan kımıldamıyor; anahtarı hiç olmamış gibi. Bu çekmeceyi isteyen herkes açabilirdi.",
            "short": "Çekmece"
          }
        },
        {
          "id": "ob_dahili",
          "name": "Dahili telefon",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 120, "y": 120, "w": 34, "h": 24 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": 20 }],
          "feedback": {
            "text": "Krem rengi, ekranlı bir dahili telefon. Arayanın numarasını gösteriyor ama hafızası her gece siliniyor. Yedi hafta önceki bir sabahı hatırlamaz.",
            "short": "Dahili"
          }
        },
        {
          "id": "ob_bardak",
          "name": "Çay bardağı",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 250, "y": 122, "w": 16, "h": 22 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "İnce belli bir bardak, dibinde yedi haftalık kurumuş çay. Kimse yıkamamış. Bir alışkanlığın fosili; delil değil.",
            "short": "Bardak"
          }
        },
        {
          "id": "ob_saksi",
          "name": "Sardunya",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 290, "y": 70, "w": 34, "h": 50 } }],
          "effects": [{ "type": "SCORE", "category": "ARASTIRMA", "amount": -10 }],
          "feedback": {
            "text": "Kurumuş bir sardunya. Toprağı çatlamış. Halil her sabah sularmış; yedi haftadır kimse sulamamış.",
            "short": "Saksı"
          }
        }
      ]
    },
    {
      "id": "sc_koridor",
      "title": "İkinci kat koridoru",
      "description": "Florasan, linolyum, sıra fişi makinesinin uzaktan gelen sesi. Bir pano, bir dolap, bir çay ocağı.",
      "width": 344,
      "height": 300,
      "image": "img_koridor",
      "objects": [
        {
          "id": "ob_rehber",
          "name": "Dahili rehber panosu",
