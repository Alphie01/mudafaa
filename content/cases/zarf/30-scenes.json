{
  "scenes": [
    {
      "id": "sc_oda",
      "title": "Kontrol odası",
      "description": "İkinci kat, 231. Halil Ekinci’nin yirmi yıllık masası; eşyaları koliye konmuş, masa hâlâ yerinde.",
      "width": 344,
      "height": 300,
      "image": "img_oda",
      "objects": [
        {
          "id": "ob_takvim",
          "name": "Masa takvimi",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 196, "y": 120, "w": 40, "h": 26 } }],
          "effects": [
            { "type": "DISCOVER", "evidence": "clue_takvim_214" },
            { "type": "SCORE", "category": "ARASTIRMA", "amount": 60 }
          ],
          "feedback": {
            "text": "Masa takvimi 12 Mart’ta kalmış. Dik, kurallı bir el yazısı: “10.35 — 214 — Md. Hn.?” Arayanın dahili numarası ve bir soru işareti.",
            "short": "Takvim"
          }
        },
        {
          "id": "ob_raf",
          "name": "Dosya rafı",
          "marker": "HIDDEN",
          "shapes": [{ "rect": { "x": 24, "y": 40, "w": 80, "h": 50 } }],
