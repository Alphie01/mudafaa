          ],
          "feedback": {
            "text": "Ön odadan kasa odasına açılan ikinci kapı. Tuş takımında iki tuşun boyası aşınmış: 0 ve 2. Diğerleri yeni gibi. Bilirkişi fotoğrafladı, tutanağa yazdırdı.",
            "short": "Aşınmış 0 ve 2"
          }
        },
        {
          "id": "ob_takvim",
