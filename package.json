{
  "name": "mudafaa",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty && tsc -p tools/content/tsconfig.json --noEmit",
    "test": "vitest run --project case-schema --project engine --project validator --project content-tools --project api-unit",
    "test:e2e": "node apps/api/scripts/test-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:cases": "npm run build && node packages/validator/dist/cli.js content/cases/gece-bekcisinin-sirri",
    "case:new": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts new",
    "case:build": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts build",
    "case:validate": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts validate",
    "case:duration": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts duration",
    "case:scenes": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts scenes",
    "case:sprite-preview": "tsx --tsconfig tools/content/tsconfig.json tools/content/src/cli.ts sprite-preview",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose --profile test down",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test redis-test",
    "mobile:test": "cd apps/mobile && fvm flutter test",
    "mobile:analyze": "cd apps/mobile && fvm flutter pub get && fvm dart analyze",
    "db:migrate": "npm run migrate -w @mudafaa/api",
    "db:migrate:test": "npm run migrate:test -w @mudafaa/api",
    "db:seed": "npm run seed -w @mudafaa/api",
    "emulators": "firebase emulators:start --only auth --project demo-mudafaa --import=.emulator-data --export-on-exit=.emulator-data",
    "dev:api": "npm run start:dev -w @mudafaa/api",
    "dev:web": "cd apps/mobile && fvm flutter run -d web-server --web-port 8090",
    "case:import": "npm run case:import -w @mudafaa/api --",
    "user:role": "npm run user:role -w @mudafaa/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
