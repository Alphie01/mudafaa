{
  "name": "mudafaa",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty",
    "test": "vitest run --project case-schema --project engine --project validator --project content-tools --project api-unit",
    "test:e2e": "vitest run --project api-e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:cases": "node packages/validator/dist/cli.js content/cases/gece-bekcisinin-sirri",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose --profile test down",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test redis-test",
    "mobile:test": "cd apps/mobile && fvm flutter test",
    "mobile:analyze": "cd apps/mobile && fvm flutter pub get && fvm dart analyze"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
