# Docker (compose --profile prod) için API ortamı. Kopyala: cp apps/api/production.env.example apps/api/.env.production
# DATABASE_URL, REDIS_URL, NODE_ENV, APP_ROLE ve TRUST_PROXY docker-compose.yml'de verilir.

FIREBASE_PROJECT_ID=mudafaa-app
# Firebase konsolu → Proje ayarları → Hizmet hesapları → "Yeni özel anahtar oluştur" ile inen JSON.
# Tek satır JSON ya da base64 (base64 -w0 key.json) olarak yapıştır. Asla commit etme.
FIREBASE_SERVICE_ACCOUNT=

CORS_ORIGINS=https://mudafaa.sehirkilavuzu.com
LOG_LEVEL=info
# Yavaş CPU'larda yayın öncesi doğrulamanın acil durdurma sınırı (ms).
VALIDATOR_MAX_MS=900000

# ── Uygulama içi satın alma (docs/iap.md → Kurulum) ──
# store: makbuzlar mağaza API'siyle doğrulanır. (fake production'da yasaktır; API açılmaz.)
PURCHASE_VERIFY_MODE=store
# Google Play Console → Kurulum → API erişimi'nde yetkilendirilmiş servis hesabının JSON anahtarı (tek satır JSON ya da
# base64 -w0 key.json). Boşsa Android satın almaları 503 store_not_configured döner. Asla commit etme.
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_PACKAGE=com.monolithyazilim.mudafaa
# App Store Connect → Kullanıcılar ve Erişim → Entegrasyonlar → Uygulama İçi Satın Alma anahtarı.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# İndirilen SubscriptionKey_XXXX.p8 dosyasının base64'ü (base64 -i SubscriptionKey_XXXX.p8 | tr -d '\n').
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.monolithyazilim.mudafaa
# App Store Connect → Uygulama → Uygulama Bilgileri → Apple Kimliği (sayısal). Production işlem doğrulaması için gerekir.
APPLE_APP_ID=
