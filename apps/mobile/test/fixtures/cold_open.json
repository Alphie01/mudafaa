    {
     "speaker": "narrator",
     "style": "card",
     "text": "Gece 23.04 — Liman mahallesi, depo sokağı",
     "bg": "sokak_yagmur",
     "fx": "fade"
    },
    {
     "speaker": "narrator",
     "text": "Yağmur, sokak lambasının titreyen ışığında iğne gibi parlıyor."
    },
    {
     "speaker": "narrator",
     "name": "Bir ses",
     "style": "phone",
     "text": "Kumaşlar sabah altıda çıkıyor. Bekçi uyuyor olacak. Kimse görmeyecek."
    },
